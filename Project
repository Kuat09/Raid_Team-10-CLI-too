package main

import (
	"bufio"
	"fmt"
	"os"
	"strings"
	"strconv"
)

const file = "tasks.txt"

type Task struct {
	ID     string
	Title  string
	Status string
}

func loadTasks() ([]Task, error) {
	file, err := os.Open(file)
	if err != nil {
		if os.IsNotExist(err) {
			return []Task{}, nil
		}
		return nil, err
	}
	defer file.Close()

	var tasks []Task
	scanner := bufio.NewScanner(file)
	for scanner.Scan() {
		line := scanner.Text()
		parts := strings.Split(line, "|")
		if len(parts) != 3 {
			continue
		}
		id := parts[0]
		title := parts[1]
		status := parts[2]
		task := Task{ID: id, Title: title, Status: status}
		tasks = append(tasks, task)
	}

	if err := scanner.Err(); err != nil {
		return nil, err
	}

	return tasks, nil
}

func CreateTask(title string) error {
	tasks, err := loadTasks()
	if err != nil {
		return err
	}

	id := strconv.Itoa(len(tasks) + 1)
	task := Task{ID: id, Title: title, Status: "TODO"}
	tasks = append(tasks, task)

	file, err := os.OpenFile(file, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)
	if err != nil {
		return err
	}
	defer file.Close()

	_, err = file.WriteString(fmt.Sprintf("%s|%s|%s\n", task.ID, task.Title, task.Status))
	if err != nil {
		return err
	}

	fmt.Println("Таска успешно создана.")
	return nil
}

