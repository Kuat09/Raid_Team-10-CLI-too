package main

import (
	"bufio"
	"fmt"
	"os"
	"strings"
	"strconv"
)

const file = "tasks.txt"

type Task struct {
	ID     string
	Title  string
	Status string
}

func loadTasks() ([]Task, error) {
	file, err := os.Open(file)
	if err != nil {
		if os.IsNotExist(err) {
			return []Task{}, nil
		}
		return nil, err
	}
	defer file.Close()

	var tasks []Task
	scanner := bufio.NewScanner(file)
	for scanner.Scan() {
		line := scanner.Text()
		parts := strings.Split(line, "|")
		if len(parts) != 3 {
			continue
		}
		id := parts[0]
		title := parts[1]
		status := parts[2]
		task := Task{ID: id, Title: title, Status: status}
		tasks = append(tasks, task)
	}

	if err := scanner.Err(); err != nil {
		return nil, err
	}

	return tasks, nil
}

func CreateTask(title string) error {
	tasks, err := loadTasks()
	if err != nil {
		return err
	}

	id := strconv.Itoa(len(tasks) + 1)
	task := Task{ID: id, Title: title, Status: "TODO"}
	tasks = append(tasks, task)

	file, err := os.OpenFile(file, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)
	if err != nil {
		return err
	}
	defer file.Close()

	_, err = file.WriteString(fmt.Sprintf("%s|%s|%s\n", task.ID, task.Title, task.Status))
	if err != nil {
		return err
	}

	fmt.Println("Таска успешно создана.")
	return nil
}

func MarkTaskAsDone(id string) error {
	tasks, err := loadTasks()
	if err != nil {
		return err
	}

	for i, task := range tasks {
		if task.ID == id {
			tasks[i].Status = "DONE"
			break
		}
	}

	file, err := os.Create(file)
	if err != nil {
		return err
	}
	defer file.Close()

	fmt.Println("Таска успешно помечена как выполненная.")
	return nil
}

func DeleteTask(id string) error {
	tasks, err := loadTasks()
	if err != nil {
		return err
	}
	for i, task := range tasks {
		if task.ID == id {
			tasks = append(tasks[:i], tasks[i+1:]...)
			break
		}
	}

	file, err := os.Create(file)
	if err != nil {
		return err
	}
	defer file.Close()

	fmt.Println("Таска успешно удалена.")
	return nil
}

func ListTasks() error {
	tasks, err := loadTasks()
	if err != nil {
		return err
	}

	if len(tasks) == 0 {
		fmt.Println("Список задач пуст.")
		return nil
	}

	fmt.Println("+----+----------------------+-------------+")
	fmt.Println("| ID | Title                | Status      |")
	fmt.Println("+----+----------------------+-------------+")
	for _, task := range tasks {
		fmt.Printf("| %-2s |", task.ID)
		fmt.Printf(" %-20s |", task.Title)
		fmt.Printf(" %-11s |\n", task.Status)
	}
	fmt.Println("+----+----------------------+-------------+")
	return nil
}

func main() {
	reader := bufio.NewReader(os.Stdin)
	for {
		fmt.Println()
		fmt.Println("=== МЕНЮ ЗАДАЧ ===")
		fmt.Println("1. Создать таску")
		fmt.Println("2. Пометить выполненным")
		fmt.Println("3. Удалить таску")
		fmt.Println("4. Все таски")
		fmt.Println("5. Завершить работу программы")
		fmt.Print("Выберите действие (1-5): ")
		input, _ := reader.ReadString('\n')
		choice := strings.TrimSpace(input)
		switch choice {
		case "1":
			fmt.Print("Введите название таски: ")
			titleInput, _ := reader.ReadString('\n')
			title := strings.TrimSpace(titleInput)
			if title == "" {
				fmt.Println("Название не может быть пустым.")
				continue
			}else if len(title) > 20 {
				fmt.Println("Название не может быть длиннее 20 символов.")
				continue
			}
			err := CreateTask(title)
			if err != nil {
				fmt.Println("Ошибка при создании таски:", err)
			}
		case "2":
			fmt.Print("Введите ID таски для пометки выполненной: ")
			idInput, _ := reader.ReadString('\n')
			id := strings.TrimSpace(idInput)
			if id == "" {
				fmt.Println("ID не может быть пустым.")
				continue
			}else if _, err := strconv.Atoi(id); err != nil {
				fmt.Println("ID должен быть числом.")
				continue
			}
			err := MarkTaskAsDone(id)
			if err != nil {
				fmt.Println("Ошибка при пометке таски как выполненной:", err)
			}
		case "3":
			fmt.Print("Введите ID таски для удаления: ")
			idInput, _ := reader.ReadString('\n')
			id := strings.TrimSpace(idInput)
			if id == "" {
				fmt.Println("ID не может быть пустым.")
				continue
			}else if _, err := strconv.Atoi(id); err != nil {
				fmt.Println("ID должен быть числом.")
				continue
			}
			err := DeleteTask(id)
			if err != nil {
				fmt.Println("Ошибка при удалении таски:", err)
			}
		case "4":
			err := ListTasks()
			if err != nil {
				fmt.Println("Ошибка при выводе тасок:", err)
			}
		case "5":
			fmt.Println("Завершение работы программы.")
			return
		default:
			fmt.Println("Неверный ввод. Введите число от 1 до 5.")
		}
		fmt.Println()
	}
}
